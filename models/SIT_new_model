"""
Simulating
    y'(t) = f(y(t), u(t)) with y(t) = (E(t), M(t), F(t), M_s(t))

Modified mosquito model:
    dE/dt   = beta_E * F * (1 - E/K) * M/(M + gamma * M_s) - (nu_E + delta_E) * E
    dF/dt   = nu * nu_E * E - delta_F * F
    dM/dt   = (1 - nu) * nu_E * E - delta_M * M
    dM_s/dt = u - delta_S * M_s

Main observation (ovitrap collection):
    E_n = int_{T_{n-1}}^{T_n} beta_E * F * (1 - E/K) dt

Optional direct observations from the old model (`obs_MMS`, `obs_F`) are kept.

Example simulation command
    python simulate.py SimODEDiscreteLuis --dt 1e-3

Example training command
    python train.py SimODEDiscreteLuis --sim_kwargs "dict(obs_E=True, obs_MMS=True, obs_F=True)" --tmax 100.0 --dt 1e-3 \
        --action_min 0 --action_max "10 * self.sim.K" --cpus 1 --steps 1e9
"""

import numpy as np

from waves.simulation import Simulation


def normalize(x, xmin, xmax):
    """Transform x from [xmin, xmax] range to [-1, 1] range."""
    return (x - xmin) / (xmax - xmin) * 2.0 - 1.0


class SimODEdiscreteLuis(Simulation):
    def __init__(
        self,
        K=50000.0,
        obs_time=False,
        obs_y=False,
        obs_y0=False,
        obs_E=True,
        obs_MMS=False,
        obs_MS=False,
        obs_F=False,
        obs_all_females=False,
        gamma=1.0,
        ovitrap_period=7.0,
        ovitrap_times=None,
        rwd_y123=0,
        rwd_y4=0,
        rwd_y4_last100=0,
        **kwargs,
    ):
        """
        See parent class.

        K: state space is [0, K]^4, action space is [0, 10*K]
        ovitrap_period: time between two collections if `ovitrap_times` is not provided
        ovitrap_times: optional list/array of absolute collection times T_n

        obs_x: whether to add observation "x" to the state space (default False = don't add that state)
        rwd_x: coefficient in front of the "x" term in the reward function (default 0 = don't add that term)
        """
        if ovitrap_period <= 0:
            raise ValueError("ovitrap_period must be > 0.")
        if gamma < 0:
            raise ValueError("gamma must be >= 0.")

        self.K = K

        self.obs_time = obs_time
        self.obs_y = obs_y
        self.obs_y0 = obs_y0
        self.obs_E = obs_E
        self.obs_MMS = obs_MMS
        self.obs_MS = obs_MS
        self.obs_F = obs_F
        self.obs_all_females = obs_all_females
        self.rwd_y123 = rwd_y123
        self.rwd_y4 = rwd_y4
        self.rwd_y4_last100 = rwd_y4_last100

        # Ovitrap collection schedule
        self.ovitrap_period = float(ovitrap_period)
        if ovitrap_times is None:
            self.ovitrap_times = None
        else:
            ovitrap_times = np.asarray(ovitrap_times, dtype=float)
            if ovitrap_times.ndim != 1:
                raise ValueError("ovitrap_times must be a 1D list/array of times.")
            if np.any(ovitrap_times <= 0):
                raise ValueError("All ovitrap_times must be strictly positive.")
            self.ovitrap_times = np.unique(np.sort(ovitrap_times))

        # model parameters
        self.nu = 0.49  # sex ratio at emergence
        self.nuE = 0.25  # emergence rate
        self.deltaE = 0.03  # egg death rate
        self.deltaS = 0.12  # sterile male death rate
        self.deltaM = 0.1  # wild male death rate
        self.deltaF = 0.04  # female death rate
        self.betaE = 8  # egg laying rate
        self.gamma = float(gamma)  # female mating preference reduction for sterile males

        # keep old attribute name for compatibility with existing code
        self.gammas = self.gamma

        # internal ovitrap observation state
        self.ovitrap_integral = 0.0
        self.last_ovitrap_obs = 0.0
        self.next_ovitrap_idx = 0
        self.next_ovitrap_time = np.inf

        sim_params = {
            "y0": lambda x: np.random.uniform(low=0.0, high=5 * K, size=(len(x),)),
            # State ordering: [E, M, F, M_s]
            "dt": 1e-4,
            "dx": 1,
            "xmin": 0,
            "xmax": 3,
        }
        sim_params.update(kwargs)
        super().__init__(**sim_params)

        if self.xmin != 0 or self.xmax != 3 or self.dx != 1:
            raise ValueError("xmin, xmax and dx cannot be modified in this simulation.")

    @property
    def n_controls(self):
        return 1

    def reset(self, y0=None):
        super().reset(y0)
        self.ovitrap_integral = 0.0
        self.last_ovitrap_obs = 0.0
        if self.ovitrap_times is None:
            self.next_ovitrap_idx = 0
            self.next_ovitrap_time = self.ovitrap_period
        else:
            self.next_ovitrap_idx = 0
            self.next_ovitrap_time = (
                float(self.ovitrap_times[0]) if len(self.ovitrap_times) > 0 else np.inf
            )

    def dynamics(self, x=[0, 0, 0, 0], u=[0]):
        """
        Dynamic of the system.
        State ordering is [E, M, F, M_s].
        """
        u = np.abs(u[0])

        assert len(x) == 4

        mating_denom = x[1] + self.gamma * x[3]
        mating_ratio = 0.0 if mating_denom <= 1e-12 else x[1] / mating_denom

        return np.array(
            [
                self.betaE * x[2] * (1 - (x[0] / self.K)) * mating_ratio - (self.nuE + self.deltaE) * x[0],
                (1 - self.nu) * self.nuE * x[0] - self.deltaM * x[1],
                self.nu * self.nuE * x[0] - self.deltaF * x[2],
                u - self.deltaS * x[3],
            ]
        )

    def _update_ovitrap_observation(self):
        # If one or several collection times are crossed, publish the last integral and reset.
        eps = 1e-12
        while self.t + eps >= self.next_ovitrap_time:
            self.last_ovitrap_obs = self.ovitrap_integral
            self.ovitrap_integral = 0.0

            if self.ovitrap_times is None:
                self.next_ovitrap_time += self.ovitrap_period
            else:
                self.next_ovitrap_idx += 1
                if self.next_ovitrap_idx < len(self.ovitrap_times):
                    self.next_ovitrap_time = float(self.ovitrap_times[self.next_ovitrap_idx])
                else:
                    self.next_ovitrap_time = np.inf

    def update_y(self, u=0):
        current_y = np.copy(self.y)

        # Integrand for ovitrap observation: betaE * F * (1 - E/K)
        self.ovitrap_integral += self.dt * self.betaE * current_y[2] * (1 - current_y[0] / self.K)

        self.y = np.array(current_y) + self.dt * self.dynamics(current_y, u)
        self._update_ovitrap_observation()

    def get_obs(self, **kwargs):
        state = []
        y = self.y

        if self.obs_time:
            state.append(normalize(self.t, 0, self.tmax))

        if self.obs_y:
            state.append(normalize(y[0], 0, 2 * self.K))
            state.append(normalize(y[1], 0, 2 * self.K))
            state.append(normalize(y[2], 0, 2 * self.K))
            state.append(normalize(y[3], 0, 50 * self.K))

        if self.obs_y0:
            state.append(normalize(y[0], 0, 2 * self.K))
            state.append(normalize(y[1], 0, 2 * self.K))
            state.append(normalize(y[2], 0, 2 * self.K))
            state.append(normalize(y[3], 0, 50 * self.K))

        if self.obs_E:
            en = kwargs.get("En", self.last_ovitrap_obs)
            en_scale = max(self.betaE * self.ovitrap_period * self.K, 1.0)
            state.append(normalize(en, 0, 20 * en_scale))
            state.append(normalize(min(en, 10 * en_scale), 0, 10 * en_scale))
            state.append(normalize(min(en, en_scale), 0, en_scale))
            state.append(normalize(min(en, 5000), 0, 5000))
            state.append(normalize(min(en, 500), 0, 500))
            state.append(normalize(min(en, 50), 0, 50))
            state.append(normalize(min(en, 5), 0, 5))

        if self.obs_MMS:
            mms = kwargs.get("MMS", y[1] + y[3])
            state.append(normalize(mms, 0, 100 * self.K))
            state.append(normalize(min(mms, 50 * self.K), 0, 50 * self.K))
            state.append(normalize(min(mms, 10 * self.K), 0, 10 * self.K))
            state.append(normalize(min(mms, self.K), 0, self.K))
            state.append(normalize(min(mms, 5000), 0, 5000))
            state.append(normalize(min(mms, 500), 0, 500))
            state.append(normalize(min(mms, 50), 0, 50))
            state.append(normalize(min(mms, 5), 0, 5))

        if self.obs_MS:
            state.append(normalize(y[3], 0, 50 * self.K))

        if self.obs_F:
            state.append(normalize(y[2], 0, 2 * self.K))
            state.append(normalize(min(y[2], 5000), 0, 5000))
            state.append(normalize(min(y[2], 500), 0, 500))
            state.append(normalize(min(y[2], 50), 0, 50))
            state.append(normalize(min(y[2], 5), 0, 5))

        if self.obs_all_females:
            m = max(y[1], 1e-12)
            all_females = kwargs.get("F", y[2] * (1 + self.gamma * y[3] / m))
            state.append(normalize(all_females, 0, 100 * self.K))
            state.append(normalize(min(all_females, 50 * self.K), 0, 50 * self.K))
            state.append(normalize(min(all_females, 10 * self.K), 0, 10 * self.K))
            state.append(normalize(min(all_females, self.K), 0, self.K))
            state.append(normalize(min(all_females, 5000), 0, 5000))
            state.append(normalize(min(all_females, 500), 0, 500))
            state.append(normalize(min(all_females, 50), 0, 50))
            state.append(normalize(min(all_females, 5), 0, 5))

        return np.array(state)

    def reward(self, action=None):
        reward = 0
        reward_info = {}

        # penalize norm of first three states
        if self.rwd_y123 > 0:
            rwd_y123 = -self.rwd_y123 * np.linalg.norm([self.y[0], self.y[1], self.y[2]]) / self.K
            reward_info["rwd_y123"] = rwd_y123
            reward += rwd_y123

        # penalize (norm of) fourth state
        if self.rwd_y4 > 0:
            rwd_y4 = -self.rwd_y4 * self.y[3] / self.K
            reward_info["rwd_y4"] = rwd_y4
            reward += rwd_y4

        # penalize fourth state in the last 100 seconds
        if self.rwd_y4_last100 > 0:
            if self.t > self.tmax - 100:
                rwd_y4_last100 = -self.rwd_y4_last100 * self.y[3] / self.K
            else:
                rwd_y4_last100 = 0
            reward_info["rwd_y4_last100"] = rwd_y4_last100
            reward += rwd_y4_last100

        return reward, reward_info
